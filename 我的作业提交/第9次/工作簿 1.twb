      <aliases enabled='yes' />
      <column caption='是否满意（自定义计算字段）' datatype='string' name='[Calculation_1745989312528920576]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [服务评价满意率]&gt;0.95 THEN &quot;满意&quot;&#13;&#10;ELSE &quot;不满意&quot;&#13;&#10;END' />
      </column>
      <column caption='N天移动平均' datatype='real' name='[Calculation_605171232144101376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(AVG([人工服务接听量]),1-[Parameters].[参数 1],0)'>
          <table-calc level-address='[federated.0kdntqc00qtdj610kpehs11fjs1d].[none:日期:ok]' ordering-field='[federated.0kdntqc00qtdj610kpehs11fjs1d].[日期]' ordering-type='Field' />
        </calculation>
      </column>
